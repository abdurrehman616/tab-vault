{
  "manifest_version": 3,
  "name": "TabVault",
  "version": "0.1.0",
  "description": "Save, organize, and restore your browser tabs.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": ["tabs", "storage", "tabGroups"]
}
